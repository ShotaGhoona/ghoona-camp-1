# Ghoona Camp Backend Environment Variables

# Basic Configuration
PORT=8080
APP_ENV=development

# Clerk Authentication (必須: 認証に使用)
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# Database (必須: BE-02-arch-02で実装済み)
# Supabase接続文字列（実際のプロジェクト情報に置き換えてください）
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Database Connection Pool (optional: パフォーマンスチューニング用)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
# DB_LOG_LEVEL=warn

# Discord Integration (BE-05-*で追加予定)  
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
# DISCORD_BOT_TOKEN=your_discord_bot_token_here